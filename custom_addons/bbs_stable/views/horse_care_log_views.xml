<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_bbs_horse_care_log_tree" model="ir.ui.view">
        <field name="name">bbs.horse.care.log.tree</field>
        <field name="model">bbs.horse.care.log</field>
        <field name="arch" type="xml">
            <tree string="Logbook Perawatan Kuda" decoration-success="state == 'done'" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="date"/>
                <field name="horse_id"/>
                <field name="activity_type"/>
                <field name="groomer_id"/>
                <field name="description"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'" 
                       decoration-success="state == 'done'"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_bbs_horse_care_log_form" model="ir.ui.view">
        <field name="name">bbs.horse.care.log.form</field>
        <field name="model">bbs.horse.care.log</field>
        <field name="arch" type="xml">
            <form string="Log Perawatan Kuda">
                <header>
                    <button name="action_set_done" 
                            string="Tandai Selesai" 
                            type="object" 
                            class="oe_highlight" 
                            invisible="state == 'done'"/>
                    <button name="action_set_draft" 
                            string="Set ke Draft" 
                            type="object" 
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nomor Log"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Target Perawatan">
                            <field name="horse_id"/>
                            <field name="activity_type"/>
                            <field name="date"/>
                        </group>
                        <group string="Petugas">
                            <field name="groomer_id"/>
                        </group>
                    </group>
                    <group string="Detail Catatan &amp; Temuan">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_bbs_horse_care_log_search" model="ir.ui.view">
        <field name="name">bbs.horse.care.log.search</field>
        <field name="model">bbs.horse.care.log</field>
        <field name="arch" type="xml">
            <search string="Cari Log">
                <field name="name"/>
                <field name="horse_id"/>
                <field name="groomer_id"/>
                <separator/>
                <filter string="Perawatan Kaki / Kuku" name="hoof" domain="[('activity_type', '=', 'hoof_care')]"/>
                <filter string="Grooming &amp; Mandi" name="grooming" domain="[('activity_type', '=', 'grooming')]"/>
                <filter string="Medis &amp; Obat" name="medical" domain="[('activity_type', '=', 'medical')]"/>
                <filter string="Belum Selesai (Draft)" name="draft" domain="[('state', '=', 'draft')]"/>
                <group expand="0" string="Group By">
                    <filter string="Kuda" name="group_horse" context="{'group_by': 'horse_id'}"/>
                    <filter string="Groomer" name="group_groomer" context="{'group_by': 'groomer_id'}"/>
                    <filter string="Jenis Aktivitas" name="group_activity" context="{'group_by': 'activity_type'}"/>
                    <filter string="Tanggal" name="group_date" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_bbs_horse_care_log" model="ir.actions.act_window">
        <field name="name">Log Perawatan &amp; Aktivitas</field>
        <field name="res_model">bbs.horse.care.log</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Catat log kerja perawatan kaki, grooming, atau aktivitas kuda hari ini!
            </p>
        </field>
    </record>
</odoo>
