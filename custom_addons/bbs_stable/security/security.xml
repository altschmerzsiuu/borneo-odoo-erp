<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kategori Modul di Settings User -->
    <record id="module_category_bbs_stable" model="ir.module.category">
        <field name="name">Borneo Berkuda Stable</field>
        <field name="description">Tingkatan akses untuk operasional kandang Borneo Berkuda Stable</field>
        <field name="sequence">20</field>
    </record>

    <!-- Group 1: Groomer / Staf Lapangan -->
    <record id="group_bbs_user" model="res.groups">
        <field name="name">Groomer / Staf Lapangan</field>
        <field name="category_id" ref="module_category_bbs_stable"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Group 2: Stable Manager / Admin -->
    <record id="group_bbs_manager" model="res.groups">
        <field name="name">Stable Manager / Admin</field>
        <field name="category_id" ref="module_category_bbs_stable"/>
        <field name="implied_ids" eval="[(4, ref('group_bbs_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Sequence otomatis untuk Nomor Log Perawatan -->
    <record id="seq_bbs_horse_care_log" model="ir.sequence">
        <field name="name">BBS Horse Care Log Sequence</field>
        <field name="code">bbs.horse.care.log</field>
        <field name="prefix">LOG/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
