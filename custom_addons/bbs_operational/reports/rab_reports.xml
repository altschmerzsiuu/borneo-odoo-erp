<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Paperformat Khusus BBS (Margin Ramping & Proporsional) -->
    <record id="paperformat_bbs_report" model="report.paperformat">
        <field name="name">BBS Laporan A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- 1. Daftarkan Aksi Tombol Print PDF -->
    <record id="action_report_bbs_rab" model="ir.actions.report">
        <field name="name">Laporan RAB &amp; Realisasi Kas</field>
        <field name="model">bbs.rab</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bbs_operational.report_rab_template</field>
        <field name="report_file">bbs_operational.report_rab_template</field>
        <field name="print_report_name">'Laporan_RAB_' + (object.name or '').replace(' ', '_')</field>
        <field name="binding_model_id" ref="model_bbs_rab"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_bbs_report"/>
    </record>

    <!-- 2. Desain Template Dokumen PDF Resmi BBS -->
    <template id="report_rab_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family: Arial, sans-serif; font-size: 13px; color: #333;">
                        
                        <!-- Header Judul Laporan & Logo BBS -->
                        <div class="row align-items-center mb-3">
                            <div class="col-3 text-start">
                                <img src="/bbs_operational/static/src/img/bbs_logo.jpg" style="max-height: 85px; max-width: 150px; object-fit: contain;" alt="Borneo Horse Stable"/>
                            </div>
                            <div class="col-9 text-end">
                                <h2 style="font-weight: bold; margin-bottom: 2px; color: #1b4d3e;">BORNEO BERKUDA STABLE</h2>
                                <h4 style="font-weight: bold; margin-top: 0; color: #555;">
                                    <t t-if="doc.cash_flow_ids">LAPORAN RENCANA ANGGARAN &amp; REALISASI KAS</t>
                                    <t t-else="">PENGAJUAN RENCANA ANGGARAN BIAYA (RAB)</t>
                                </h4>
                                <p style="font-size: 11px; color: #777; margin-bottom: 0;">Periode: <strong t-field="doc.name"/> | Tanggal Cetak: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/></p>
                            </div>
                        </div>
                        <hr style="border-top: 2px solid #1b4d3e; margin-top: 5px; margin-bottom: 20px;"/>

                        <!-- Ringkasan Finansial Eksekutif (Tabel Simetris) -->
                        <div class="mb-4">
                            <t t-if="doc.cash_flow_ids">
                                <table class="table table-sm table-bordered" style="width: 100%; table-layout: fixed; margin-bottom: 0;">
                                    <colgroup>
                                        <col style="width: 25%;"/>
                                        <col style="width: 25%;"/>
                                        <col style="width: 25%;"/>
                                        <col style="width: 25%;"/>
                                    </colgroup>
                                    <thead style="background-color: #f8f9fa;">
                                        <tr>
                                            <th colspan="2" class="text-center" style="color: #1b4d3e; font-weight: bold; border-right: 2px solid #dee2e6;">INFORMASI ANGGARAN</th>
                                            <th colspan="2" class="text-center" style="color: #1b4d3e; font-weight: bold;">RINGKASAN REALISASI KAS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td style="color: #555;">Periode Bulan</td>
                                            <td class="text-end" style="border-right: 2px solid #dee2e6;"><strong><span t-field="doc.month"/> / <t t-esc="doc.year"/></strong></td>
                                            <td style="color: #555;">Total Kas Masuk</td>
                                            <td class="text-end" style="color: #008766; font-weight: bold;"><span t-field="doc.total_kas_masuk" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                        </tr>
                                        <tr>
                                            <td style="color: #555;">Tanggal Pengajuan</td>
                                            <td class="text-end" style="border-right: 2px solid #dee2e6;"><span t-field="doc.date_submission"/></td>
                                            <td style="color: #555;">Total Kas Keluar</td>
                                            <td class="text-end" style="color: #d9534f; font-weight: bold;"><span t-field="doc.total_kas_keluar" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                        </tr>
                                        <tr style="background-color: #f4fbf7;">
                                            <td><strong>Total Anggaran (RAB)</strong></td>
                                            <td class="text-end" style="border-right: 2px solid #dee2e6;"><strong style="color: #008766; font-size: 13px;"><span t-field="doc.total_amount" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></strong></td>
                                            <td><strong>Saldo Akhir Kas</strong></td>
                                            <td class="text-end" t-attf-style="background-color: #{'#fff1f0' if doc.balance &lt; 0 else '#f4fbf7'};">
                                                <strong t-attf-style="font-size: 13px; color: #{'#d9534f' if doc.balance &lt; 0 else '#008766'};">
                                                    <span t-field="doc.balance" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                                </strong>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                            <t t-else="">
                                <table class="table table-sm table-bordered" style="width: 100%; table-layout: fixed; margin-bottom: 0;">
                                    <colgroup>
                                        <col style="width: 50%;"/>
                                        <col style="width: 50%;"/>
                                    </colgroup>
                                    <thead style="background-color: #f8f9fa;">
                                        <tr>
                                            <th colspan="2" class="text-center" style="color: #1b4d3e; font-weight: bold;">INFORMASI PENGAJUAN ANGGARAN</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td style="color: #555;">Periode Anggaran</td>
                                            <td class="text-end"><strong><span t-field="doc.month"/> / <t t-esc="doc.year"/></strong></td>
                                        </tr>
                                        <tr>
                                            <td style="color: #555;">Tanggal Pengajuan</td>
                                            <td class="text-end"><span t-field="doc.date_submission"/></td>
                                        </tr>
                                        <tr style="background-color: #f4fbf7;">
                                            <td><strong>Total Rencana Anggaran (RAB)</strong></td>
                                            <td class="text-end"><strong style="color: #008766; font-size: 14px;"><span t-field="doc.total_amount" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></strong></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                        </div>

                        <!-- Bagian 1: Tabel Rincian Anggaran Belanja (RAB) -->
                        <h5 style="font-weight: bold; color: #1b4d3e; margin-top: 20px;">
                            <t t-if="doc.cash_flow_ids">1. Rincian Kebutuhan Anggaran (RAB)</t>
                            <t t-else="">Rincian Kebutuhan Anggaran (RAB)</t>
                        </h5>
                        <table class="table table-sm table-striped table-bordered">
                            <thead style="background-color: #1b4d3e; color: white;">
                                <tr>
                                    <th class="text-center" style="width: 5%;">No</th>
                                    <th>Uraian / Kebutuhan Belanja</th>
                                    <th class="text-center" style="width: 10%;">Jumlah</th>
                                    <th class="text-center" style="width: 10%;">Satuan</th>
                                    <th class="text-end" style="width: 18%;">Harga Satuan</th>
                                    <th class="text-end" style="width: 20%;">Total (Rp)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="no_line" t-value="1"/>
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <tr>
                                        <td class="text-center"><t t-esc="no_line"/></td>
                                        <td>
                                            <span t-field="line.name" style="font-weight: 600; color: #1f2937;"/>
                                            <t t-if="line.is_talangan">
                                                <span class="text-muted fst-italic" style="font-size: 11px;"> (Talangan Staf)</span>
                                            </t>
                                        </td>
                                        <td class="text-center"><span t-field="line.qty"/></td>
                                        <td class="text-center"><span t-field="line.uom"/></td>
                                        <td class="text-end"><span t-field="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                        <td class="text-end" style="font-weight: bold;"><span t-field="line.subtotal" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                    </tr>
                                    <t t-set="no_line" t-value="no_line + 1"/>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background-color: #f1f1f1; font-weight: bold;">
                                    <td colspan="5" class="text-end">TOTAL ANGGARAN:</td>
                                    <td class="text-end" style="color: #008766; font-size: 14px;">
                                        <span t-field="doc.total_amount" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- Bagian 2 & 3: Hanya Muncul Jika Ada Transaksi Kas Riil -->
                        <t t-if="doc.cash_flow_ids">
                            <!-- Bagian 2: Rekapitulasi Realisasi per Pos Kategori (Executive Summary) -->
                            <h5 style="font-weight: bold; color: #1b4d3e; margin-top: 25px;">2. Rekapitulasi Realisasi Pengeluaran Kas per Pos</h5>
                            <table class="table table-sm table-bordered">
                                <thead style="background-color: #2b4c3b; color: white;">
                                    <tr>
                                        <th class="text-center" style="width: 5%;">No</th>
                                        <th>Pos / Kategori Pengeluaran</th>
                                        <th class="text-center" style="width: 15%;">Frekuensi</th>
                                        <th class="text-end" style="width: 25%;">Total Pengeluaran (Rp)</th>
                                        <th class="text-end" style="width: 15%;">Porsi (%)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="no_cat" t-value="1"/>
                                    <t t-foreach="doc.get_cash_flow_category_summary()" t-as="cat">
                                        <tr>
                                            <td class="text-center"><t t-esc="no_cat"/></td>
                                            <td><strong><t t-esc="cat['name']"/></strong></td>
                                            <td class="text-center"><t t-esc="cat['count']"/> transaksi</td>
                                            <td class="text-end" style="font-weight: bold; color: #d9534f;">
                                                <span t-esc="cat['total']" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                            </td>
                                            <td class="text-end text-muted">
                                                <t t-esc="'{:.1f}%'.format(cat['percentage'])"/>
                                            </td>
                                        </tr>
                                        <t t-set="no_cat" t-value="no_cat + 1"/>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr style="background-color: #f8f9fa; font-weight: bold;">
                                        <td colspan="3" class="text-end">TOTAL REALISASI PENGELUARAN KAS:</td>
                                        <td class="text-end" style="color: #d9534f; font-size: 13px;">
                                            <span t-field="doc.total_kas_keluar" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </td>
                                        <td class="text-end">100.0%</td>
                                    </tr>
                                </tfoot>
                            </table>

                            <!-- Bagian 3: Tabel Rincian Buku Kas Harian -->
                            <h5 style="font-weight: bold; color: #1b4d3e; margin-top: 25px;">3. Rincian Mutasi Transaksi Kas Harian</h5>
                            <table class="table table-sm table-bordered">
                                <thead style="background-color: #334d40; color: white;">
                                    <tr>
                                        <th style="width: 15%;">No. Ref</th>
                                        <th style="width: 12%;">Tanggal</th>
                                        <th>Keterangan Transaksi</th>
                                        <th style="width: 10%;">PIC</th>
                                        <th class="text-center" style="width: 12%;">Tipe</th>
                                        <th class="text-end" style="width: 18%;">Nominal (Rp)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.cash_flow_ids" t-as="cf">
                                        <tr>
                                            <td><span t-field="cf.ref"/></td>
                                            <td><span t-field="cf.date"/></td>
                                            <td><span t-field="cf.name"/></td>
                                            <td><span t-field="cf.pic_type"/></td>
                                            <td class="text-center">
                                                <t t-if="cf.transaction_type == 'in'">
                                                    <span style="color: #008766; font-weight: bold;">Masuk</span>
                                                </t>
                                                <t t-else="">
                                                    <span style="color: #d9534f; font-weight: bold;">Keluar</span>
                                                </t>
                                            </td>
                                            <td class="text-end" style="font-weight: bold;">
                                                <span t-field="cf.amount" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- Kolom Tanda Tangan Resmi -->
                        <div class="row mt-5" style="page-break-inside: avoid;">
                            <div class="col-6 text-center">
                                <p style="margin-bottom: 60px;">Diajukan Oleh,<br/><strong>Admin Operasional BBS</strong></p>
                                <p style="margin-bottom: 0;"><strong><u>Tiara Nisa</u></strong></p>
                                <p style="color: #777; font-size: 11px;">Staf Operasional BBS</p>
                            </div>
                            <div class="col-6 text-center">
                                <p style="margin-bottom: 60px;">Disetujui Oleh,<br/><strong>Owner Borneo Berkuda Stable</strong></p>
                                <p style="margin-bottom: 0;"><strong><u>Dheny P.</u></strong></p>
                                <p style="color: #777; font-size: 11px;">Owner / Pengelola</p>
                            </div>
                        </div>

                        <!-- Catatan Kaki Dokumen Resmi -->
                        <div class="text-center text-muted mt-5 pt-3" style="font-size: 11px; border-top: 1px solid #e0e0e0;">
                            <span>Borneo Berkuda Stable &amp;bull; Dokumen Resmi Anggaran &amp; Realisasi Kas &amp;bull;</span>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
