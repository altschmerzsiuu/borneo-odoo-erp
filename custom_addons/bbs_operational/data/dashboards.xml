<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Spreadsheet Dashboard Group untuk BBS -->
    <record id="spreadsheet_dashboard_group_bbs" model="spreadsheet.dashboard.group">
        <field name="name">Borneo Berkuda Stable</field>
        <field name="sequence">1</field>
    </record>

    <!-- Spreadsheet Dashboard Record untuk Kas & Operasional BBS -->
    <record id="spreadsheet_dashboard_bbs_kas" model="spreadsheet.dashboard">
        <field name="name">Kas &amp; Operasional BBS</field>
        <field name="spreadsheet_binary_data" type="base64" file="bbs_operational/data/files/bbs_dashboard.json"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard_group_bbs"/>
        <field name="group_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="sequence">10</field>
    </record>

</odoo>
