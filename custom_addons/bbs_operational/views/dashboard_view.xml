<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Action Grafik Pengeluaran Kas untuk Dashboard -->
    <record id="action_bbs_dashboard_expense_graph" model="ir.actions.act_window">
        <field name="name">Grafik Pengeluaran per Pos</field>
        <field name="res_model">bbs.cash.flow</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_bbs_cash_flow_graph"/>
        <field name="domain">[('transaction_type', '=', 'out')]</field>
    </record>

    <!-- 2. Action Rekapitulasi Pivot untuk Dashboard -->
    <record id="action_bbs_dashboard_pivot" model="ir.actions.act_window">
        <field name="name">Rekapitulasi Arus Kas</field>
        <field name="res_model">bbs.cash.flow</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_bbs_cash_flow_pivot"/>
    </record>

    <!-- 3. Action 10 Transaksi Kas Terbaru -->
    <record id="action_bbs_dashboard_latest_cf" model="ir.actions.act_window">
        <field name="name">Mutasi Kas Terbaru</field>
        <field name="res_model">bbs.cash.flow</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_bbs_cash_flow_tree"/>
        <field name="limit">10</field>
    </record>

    <!-- 4. Definisi Form Board Dashboard BBS -->
    <record id="view_bbs_operational_board" model="ir.ui.view">
        <field name="name">bbs.operational.board</field>
        <field name="model">board.board</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Dashboard Eksekutif BBS">
                <board style="2-1">
                    <column>
                        <action name="%(bbs_operational.action_bbs_dashboard_expense_graph)d" string="Visualisasi Pengeluaran per Pos"/>
                        <action name="%(bbs_operational.action_bbs_dashboard_latest_cf)d" string="10 Transaksi Kas Terbaru"/>
                    </column>
                    <column>
                        <action name="%(bbs_operational.action_bbs_dashboard_pivot)d" string="Rekapitulasi Kas Masuk, Keluar &amp; Saldo"/>
                    </column>
                </board>
            </form>
        </field>
    </record>

    <!-- 5. Action Window Pembuka Dashboard -->
    <record id="action_bbs_operational_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">board.board</field>
        <field name="view_mode">form</field>
        <field name="usage">menu</field>
        <field name="view_id" ref="view_bbs_operational_board"/>
    </record>

    <!-- 6. Menu Dashboard ditaruh di paling atas (sequence=1) -->
    <menuitem id="menu_bbs_dashboard_main"
              name="Dashboard"
              parent="menu_bbs_operational_root"
              action="action_bbs_operational_dashboard"
              sequence="1"/>

</odoo>
