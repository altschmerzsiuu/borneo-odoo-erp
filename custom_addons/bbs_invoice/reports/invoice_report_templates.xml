<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================================= -->
    <!-- TEMPLATE FAKTUR RESMI BORNEO BERKUDA STABLE (FORMAT ATM KMS)              -->
    <!-- Catatan untuk Admin: Anda bisa mengedit teks/tampilan langsung di file ini! -->
    <!-- ========================================================================= -->
    <template id="report_invoice_document_bbs">
        <t t-set="o" t-value="o.with_context(lang=lang)"/>
        <div class="article" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1f2937; line-height: 1.4; padding: 0 15px; margin-top: 0;">
            
            <!-- ======================================================== -->
            <!-- 1. KOP SURAT (HEADER): LOGO & IDENTITAS PERUSAHAAN BBS   -->
            <!-- ======================================================== -->
            <div class="row align-items-center" style="margin-top: 0; padding-top: 0; margin-bottom: 6px;">
                <div class="col-4" style="padding-top: 0;">
                    <!-- Logo BBS Resmi (Base64 agar selalu muncul tajam dan proporsional) -->
                    <img t-if="o.bbs_logo_image" t-att-src="image_data_uri(o.bbs_logo_image)" style="max-height: 110px; max-width: 240px; width: auto; object-fit: contain;" alt="Logo Borneo Berkuda Stable"/>
                    <img t-elif="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 110px; max-width: 240px; width: auto; object-fit: contain;" alt="Logo Company"/>
                </div>
                <div class="col-8 text-end" style="padding-top: 0;">
                    <div style="font-size: 19px; font-weight: 800; color: #1b4d3e; letter-spacing: 0.5px;">BORNEO BERKUDA STABLE</div>
                    <div style="font-size: 11px; color: #4b5563; margin-top: 2px;">
                        <span t-esc="o.company_id.bbs_invoice_address_header or 'Jl. Ruhui Rahayu, Sepinggan Pratama, Balikpapan Selatan, Balikpapan, Kalimantan Timur'"/>
                    </div>
                    <div style="font-size: 11px; color: #4b5563;">
                        Telp/WA: <span t-esc="o.company_id.bbs_invoice_phone or '0851-7314-0965'"/> | Email: <span t-esc="o.company_id.bbs_invoice_email or 'operasional@borneoberkuda.co.id'"/>
                    </div>
                </div>
            </div>

            <!-- Garis Hijau Tua Pembatas Kop Surat -->
            <div style="border-bottom: 2.5px solid #1b4d3e; margin-bottom: 18px;"></div>

            <!-- ======================================================== -->
            <!-- 2. ALAMAT PENAGIHAN KLIEN & KOTAK RINGKASAN TANGGAL      -->
            <!-- ======================================================== -->
            <div class="row" style="margin-bottom: 20px;">
                <!-- Kolom Kiri: Data Klien & Nomor Invoice -->
                <div class="col-7">
                    <div style="font-size: 13px; font-weight: bold; color: #1b4d3e; margin-bottom: 3px;">Alamat Penagihan :</div>
                    <div style="font-size: 14px; font-weight: bold; color: #111827;">
                        <span t-field="o.partner_id.name"/>
                    </div>
                    <div t-if="o.partner_id.street" style="font-size: 12px; color: #374151;">
                        <span t-field="o.partner_id.street"/>
                    </div>
                    <div style="font-size: 12px; color: #374151;">
                        <span t-if="o.partner_id.city" t-field="o.partner_id.city"/>
                        <span t-if="o.partner_id.state_id">, <span t-field="o.partner_id.state_id.name"/></span>
                        <span t-if="o.partner_id.country_id">, <span t-field="o.partner_id.country_id.name"/></span>
                    </div>
                    <div t-if="o.partner_id.phone" style="font-size: 12px; color: #6b7280; margin-top: 2px;">
                        Kontak: <span t-field="o.partner_id.phone"/>
                    </div>

                    <div style="margin-top: 14px;">
                        <div style="font-size: 11px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px;">No Invoice:</div>
                        <div style="font-size: 19px; font-weight: 800; color: #111827; letter-spacing: 0.5px;">
                            <span t-if="o.name and o.name != '/'" t-field="o.name"/>
                            <span t-else="" style="color: #9ca3af;">DRAFT FAKTUR</span>
                        </div>
                    </div>
                </div>

                <!-- Kolom Kanan: 3 Kotak Header (Tanggal, Mohon Dibayar, Jatuh Tempo) -->
                <div class="col-5">
                    <table style="width: 100%; border-collapse: collapse; border: 1px solid #d1d5db; border-radius: 6px; overflow: hidden; text-align: center;">
                        <thead>
                            <tr style="background-color: #f9fafb; border-bottom: 1px solid #d1d5db; font-size: 11px;">
                                <th style="padding: 6px 4px; font-weight: 600; color: #6b7280; border-right: 1px solid #d1d5db; width: 33%;">Tanggal</th>
                                <th style="padding: 6px 4px; font-weight: 700; color: #1b4d3e; background-color: #e8f5e9; border-right: 1px solid #d1d5db; width: 34%;">Mohon Dibayar</th>
                                <th style="padding: 6px 4px; font-weight: 600; color: #6b7280; width: 33%;">Jatuh Tempo</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="font-size: 12px;">
                                <td style="padding: 8px 4px; color: #111827; border-right: 1px solid #d1d5db;">
                                    <span t-if="o.invoice_date" t-esc="o.invoice_date.strftime('%d/%m/%Y')"/>
                                    <span t-else="">-</span>
                                </td>
                                <td style="padding: 8px 4px; font-weight: 800; color: #1b4d3e; background-color: #e8f5e9; border-right: 1px solid #d1d5db;">
                                    <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td style="padding: 8px 4px; color: #111827;">
                                    <span t-if="o.invoice_date_due" t-esc="o.invoice_date_due.strftime('%d/%m/%Y')"/>
                                    <span t-elif="o.invoice_date" t-esc="o.invoice_date.strftime('%d/%m/%Y')"/>
                                    <span t-else="">-</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ======================================================== -->
            <!-- 3. TABEL RINCIAN ITEM / LAYANAN TAGIHAN                  -->
            <!-- ======================================================== -->
            <div style="margin-bottom: 18px;">
                <table class="table" style="width: 100%; border-collapse: collapse; margin-bottom: 0;">
                    <thead>
                        <tr style="border-top: 1px solid #e5e7eb; border-bottom: 2px solid #1b4d3e; background-color: #f9fafb; font-size: 12px;">
                            <th style="padding: 8px; text-align: left; color: #374151; font-weight: 700; width: 50%;">Keterangan</th>
                            <th style="padding: 8px; text-align: center; color: #374151; font-weight: 700; width: 12%;">Qty</th>
                            <th style="padding: 8px; text-align: right; color: #374151; font-weight: 700; width: 18%;">Harga (Rp.)</th>
                            <th style="padding: 8px; text-align: right; color: #374151; font-weight: 700; width: 20%;">Jumlah (Rp.)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="lines" t-value="o.invoice_line_ids.filtered(lambda l: l.display_type in ('product', False) or not l.display_type)"/>
                        <t t-foreach="lines" t-as="line">
                            <tr style="border-bottom: 1px solid #f3f4f6; font-size: 12px;">
                                <td style="padding: 9px 8px; vertical-align: top;">
                                    <div style="font-weight: 700; color: #111827;">
                                        <span t-field="line.name"/>
                                    </div>
                                </td>
                                <td style="padding: 9px 8px; text-align: center; vertical-align: top; color: #374151;">
                                    <span t-esc="'%.2f' % line.quantity if line.quantity % 1 != 0 else '%.0f' % line.quantity"/>
                                </td>
                                <td style="padding: 9px 8px; text-align: right; vertical-align: top; color: #374151;">
                                    <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td style="padding: 9px 8px; text-align: right; vertical-align: top; font-weight: 700; color: #111827;">
                                    <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- ======================================================== -->
            <!-- 4. TOTAL & SUB-TOTAL (DI SISI KANAN)                     -->
            <!-- ======================================================== -->
            <div class="row" style="margin-bottom: 22px;">
                <div class="col-6"></div>
                <div class="col-6">
                    <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                        <tr style="border-bottom: 1px solid #f3f4f6;">
                            <td style="padding: 5px 8px; font-weight: 700; color: #1b4d3e;">Subtotal</td>
                            <td style="padding: 5px 8px; text-align: right; font-weight: 700; color: #111827;">
                                <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                        <t t-if="o.amount_tax != 0">
                            <tr style="border-bottom: 1px solid #f3f4f6;">
                                <td style="padding: 5px 8px; color: #4b5563;">Pajak (PPN/PPh)</td>
                                <td style="padding: 5px 8px; text-align: right; color: #111827;">
                                    <span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                        <tr style="border-top: 1.5px solid #1b4d3e; background-color: #f9fafb;">
                            <td style="padding: 7px 8px; font-size: 14px; font-weight: 800; color: #1b4d3e;">Total Tagihan</td>
                            <td style="padding: 7px 8px; text-align: right; font-size: 14px; font-weight: 800; color: #1b4d3e;">
                                <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- ======================================================== -->
            <!-- 5. REKENING PEMBAYARAN TRANSFER & BLOK TANDA TANGAN      -->
            <!-- ======================================================== -->
            <div class="row align-items-start" style="margin-top: 15px; padding-top: 14px; border-top: 1px dashed #d1d5db;">
                
                <!-- Sisi Kiri: Rekening Bank Pembayaran Resmi BBS -->
                <div class="col-7">
                    <div style="font-size: 12px; font-weight: 700; color: #111827; margin-bottom: 3px;">
                        Pembayaran dengan transfer ditujukan kepada :
                    </div>
                    <div style="font-size: 12px; font-weight: 800; color: #1b4d3e;">
                        <span t-esc="o.bbs_payment_bank_account_name or o.company_id.bbs_invoice_bank_account_name or 'BORNEO BERKUDA STABLE'"/>
                    </div>
                    <div style="font-size: 12px; color: #374151;">
                        <span t-esc="o.bbs_payment_bank_name or o.company_id.bbs_invoice_bank_name or 'Bank Central Asia (BCA)'"/>
                    </div>
                    <div style="font-size: 12px; color: #111827;">
                        No. Rekening : <strong style="letter-spacing: 0.5px;"><span t-esc="o.bbs_payment_bank_account_number or o.company_id.bbs_invoice_bank_account_number or '037-901-111-3333'"/></strong>
                    </div>
                    <div style="font-size: 10px; color: #6b7280; margin-top: 6px;">
                        * Harap menyertakan nomor invoice pada berita transfer untuk kemudahan verifikasi kas.
                    </div>
                </div>

                <!-- Sisi Kanan: Tanda Tangan Resmi (Tanpa Barcode / QR Code, Nama Sesuai Pengaturan) -->
                <div class="col-5 text-end">
                    <div style="font-size: 11px; color: #4b5563; margin-bottom: 4px;">
                        <span t-esc="o.bbs_signer_city or 'Balikpapan'"/>, <span t-esc="o.invoice_date.strftime('%d %B %Y') if o.invoice_date else context_timestamp(datetime.datetime.now()).strftime('%d %B %Y')"/>
                    </div>
                    
                    <div style="font-size: 11px; font-weight: 600; color: #374151;">
                        <span t-esc="o.bbs_signer_title or 'Manajemen Operasional BBS'"/>
                    </div>

                    <!-- Area Tanda Tangan / Gambar Scan TTD & Stempel jika ada -->
                    <div style="min-height: 55px; margin: 5px 0;">
                        <t t-if="o.bbs_signature_image">
                            <img t-att-src="image_data_uri(o.bbs_signature_image)" style="max-height: 50px; max-width: 150px; object-fit: contain;"/>
                        </t>
                        <t t-else="">
                            <!-- Space kosong untuk tanda tangan basah & stempel manual jika dicetak print -->
                            <div style="height: 45px;"></div>
                        </t>
                    </div>

                    <!-- Garis Tanda Tangan & Nama -->
                    <div style="display: inline-block; text-align: center; min-width: 160px;">
                        <div style="border-bottom: 1px solid #374151; margin-bottom: 3px;"></div>
                        <div style="font-size: 12px; font-weight: 800; color: #111827;">
                            <span t-esc="o.bbs_signer_name or 'Manajemen BBS'"/>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </template>

    <!-- Template Induk Pelindung Loop docs -> o -->
    <template id="report_invoice_bbs_main">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang or o.env.user.lang"/>
                <t t-call="bbs_invoice.report_invoice_document_bbs" t-lang="lang"/>
            </t>
        </t>
    </template>

    <!-- Override Template Bawaan Odoo (account.report_invoice_document) agar tombol Print -> Invoices otomatis pakai format BBS ini -->
    <template id="report_invoice_document_inherit_bbs" inherit_id="account.report_invoice_document" priority="99">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-call="bbs_invoice.report_invoice_document_bbs"/>
        </xpath>
    </template>

</odoo>
