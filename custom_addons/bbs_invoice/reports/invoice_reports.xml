<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Paperformat Khusus Faktur BBS: Margin Atas Rapat (8mm) agar dokumen mulai tepat dari atas -->
    <record id="paperformat_bbs_invoice" model="report.paperformat">
        <field name="name">Format Kertas Faktur BBS (A4 Rapat Atas)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Pasang paperformat ke report utama dan set nama tunggal: 'Faktur / Invoice' -->
    <record id="account.account_invoices" model="ir.actions.report">
        <field name="name">Faktur / Invoice</field>
        <field name="paperformat_id" ref="bbs_invoice.paperformat_bbs_invoice"/>
    </record>

    <!-- Lepas tombol ganda 'Invoices without Payment' dari menu Print agar bersih hanya 1 tombol -->
    <record id="account.account_invoices_without_payment" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>

</odoo>
